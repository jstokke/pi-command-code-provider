{
  "name": "pi-command-code-provider",
  "version": "0.3.0",
  "description": "Pi extension that exposes Command Code's live model catalog as two Pi providers (OpenAI and Anthropic wire formats). Fetches the catalog lazily through Pi's model refresh, layers in pricing from the GOAT plan page, and ships Claude extended-thinking support out of the box.",
  "license": "MIT",
  "author": "Joachim Stokke <joachim@stokke.dev>",
  "type": "module",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jstokke/pi-command-code-provider.git"
  },
  "bugs": {
    "url": "https://github.com/jstokke/pi-command-code-provider/issues"
  },
  "homepage": "https://github.com/jstokke/pi-command-code-provider#readme",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test --test-timeout=8000 --test-force-exit src/core.test.mjs src/enrich.test.mjs src/native-provider.test.mjs src/declarations.test.mjs",
    "test:ci": "node --test --test-timeout=8000 src/core.test.mjs src/enrich.test.mjs src/native-provider.test.mjs src/declarations.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.85.1",
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "@types/node": "^20.19.43",
    "typescript": "^7.0.2"
  },
  "keywords": [
    "pi",
    "pi-package",
    "pi-extension",
    "command-code",
    "ai-provider",
    "llm",
    "coding-agent"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  }
}
